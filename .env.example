# Copie este arquivo para ".env" e preencha. O .env NÃO vai para o GitHub.
# Formato: CHAVE=valor (sem aspas, sem espaços em volta do =)

# Banco (Render)
DB_USER=
DB_PASSWORD=

# IA - Ollama Cloud: crie a chave em https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b

# Origens do front liberadas no CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
